# 카카오 개발자 콘솔(https://developers.kakao.com) → JavaScript 키
# 프로덕션·프리뷰 URL을 플랫폼 앱의 Web 도메인에 등록해야 지도가 로드됩니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# --- 제보 저장 (로컬·Vercel 동일) ---
# A) Vercel Storage → KV/Redis 연결 시 자동 주입되는 이름(로컬에 복사할 때도 동일 키 사용)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# B) Upstash만 단독 쓸 때(위 A가 없을 때만 사용)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
