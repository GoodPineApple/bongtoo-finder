# 카카오 개발자 콘솔(https://developers.kakao.com) → JavaScript 키
# 프로덕션·프리뷰 URL을 플랫폼 앱의 Web 도메인에 등록해야 지도가 로드됩니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# --- Vercel 프로덕션 제보 저장 (선택이지만 Vercel 배포 시 강력 권장) ---
# Vercel 대시보드 → 프로젝트 → Storage → Redis(Upstash) 생성 시 아래 변수가 자동으로 붙습니다.
# 로컬에서 Redis를 쓰려면 Upstash 콘솔에서 REST URL·토큰을 복사해 넣으면 됩니다.
# 미설정 시 `data/reports.json`을 사용합니다(로컬 단일 프로세스·Docker 볼륨에 적합).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
